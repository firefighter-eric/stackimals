{
  "name": "stackimals",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-build-budget.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run src/test",
    "test:unit": "vitest run src/test",
    "test:watch": "vitest src/test",
    "test:e2e": "playwright test",
    "test:e2e:production": "E2E_PRODUCTION=true playwright test"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "sharp": "0.35.4",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.12.0"
  }
}
